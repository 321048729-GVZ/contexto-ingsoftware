<mxfile host="app.diagrams.net">
  <diagram id="contexto" name="Diagrama de contexto">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="&lt;b&gt;Diagrama de contexto — [Nombre de su sistema]&lt;/b&gt;&lt;br&gt;Equipo: [nombre del equipo]" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#16324F;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nota" value="Borren esta nota antes de entregar.&lt;br&gt;• Hay UN solo proceso: su sistema completo (el círculo).&lt;br&gt;• Cada rectángulo es una entidad externa. Dupliquen el de ejemplo para crear más.&lt;br&gt;• Cada flecha es un flujo de DATOS con nombre. Para crear una, arrastren desde el borde de una figura hacia otra.&lt;br&gt;• Aquí no van almacenes de datos." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#FBF7EE;strokeColor=#A8812B;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="proceso" value="0&lt;br&gt;&lt;b&gt;[Nombre de su sistema]&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#16324F;strokeWidth=2;fontSize=14;fontColor=#16324F;" vertex="1" parent="1">
          <mxGeometry x="470" y="300" width="170" height="170" as="geometry" />
        </mxCell>
        <mxCell id="entidad1" value="[Entidad externa]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF7EE;strokeColor=#A8812B;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="345" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flujo1" value="[nombre del flujo de datos]" style="endArrow=classic;html=1;rounded=0;strokeColor=#16324F;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="entidad1" target="proceso">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
